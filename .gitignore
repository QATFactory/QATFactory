*.py[cod]
*.so
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.venv/
venv/

# Experiment tracking / logs
wandb/
*.log

# Editor / OS
.DS_Store
.idea/
.vscode/

