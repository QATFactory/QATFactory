# Tokenized dataset cache (repo-local, keyed by fingerprint)
cache/

# Training run outputs (HF checkpoints) and exported serving checkpoints
outputs/
exports/

# Local datasets (conversation JSONL, incl. train_eval_path splits). Root-anchored: an
