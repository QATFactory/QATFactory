{#-
  QATFactory-patched DeepSeek-R1-Distill chat template (Llama and Qwen distills).

  Two deliberate differences from the stock `chat_template` shipped with
  `deepseek-ai/DeepSeek-R1-Distill-*`:

  1. Each assistant turn (from `<｜Assistant｜>` through its trailing
     `<｜end▁of▁sentence｜>`) is wrapped in `{% generation %}` ... `{% endgeneration %}` so
     `apply_chat_template(..., return_assistant_tokens_mask=True)` yields a token-level
     assistant mask for loss supervision.
  2. The stock template *drops* the reasoning trace from assistant turns
     (`content.split('</think>')[-1]`), which is right for serving but wrong for
     distillation: R1 emits its chain of thought, so the student must be supervised on it.
     Here the reasoning is rendered natively as `<think>\n...\n</think>\n\n` — taken from a
     per-message `reasoning_content` field when present, otherwise parsed back out of an
     inline `<think>...</think>` block in `content`. This matches the on-policy generation
     format, whose prompt suffix is `<｜Assistant｜><think>\n`.

  This template is not selected by model type (the distills report `model_type: llama` /
  `qwen2`, shared with unrelated backbones); point `data.chat_template_file` at it.
-#}
{%- set ns = namespace(is_tool=false, is_output_first=true, system_prompt='') %}
{%- for message in messages %}
    {%- if message.role == 'system' %}
        {%- set ns.system_prompt = message.content %}
    {%- endif %}
{%- endfor %}
{{- bos_token }}
{{- ns.system_prompt }}
{%- for message in messages %}
    {%- if message.role == 'user' %}
        {%- set ns.is_tool = false %}
        {{- '<｜User｜>' + message.content }}
    {%- elif message.role == 'assistant' %}
        {%- generation %}
        {%- if message.content is not string %}
            {%- set ns.is_tool = false %}
            {%- for tool_call in message.tool_calls %}
                {%- if loop.first %}
                    {{- '<｜Assistant｜><｜tool▁calls▁begin｜>' }}
                {%- else %}
                    {{- '\n' }}
                {%- endif %}
                {{- '<｜tool▁call▁begin｜>' + tool_call.type + '<｜tool▁sep｜>' + tool_call.function.name }}
                {{- '\n```json\n' }}
                {%- if tool_call.function.arguments is string %}
                    {{- tool_call.function.arguments }}
                {%- else %}
                    {{- tool_call.function.arguments | tojson }}
                {%- endif %}
                {{- '\n```<｜tool▁call▁end｜>' }}
                {%- if loop.last %}
                    {{- '<｜tool▁calls▁end｜><｜end▁of▁sentence｜>' }}
                {%- endif %}
            {%- endfor %}
        {%- elif ns.is_tool %}
            {%- set ns.is_tool = false %}
            {{- '<｜tool▁outputs▁end｜>' + message.content + '<｜end▁of▁sentence｜>' }}
        {%- else %}
            {%- set content = message.content %}
            {%- set reasoning_content = '' %}
            {%- if message.reasoning_content is string %}
                {%- set reasoning_content = message.reasoning_content %}
            {%- elif '</think>' in content %}
                {%- set reasoning_content = content.split('</think>')[0].rstrip('\n').split('<think>')[-1].lstrip('\n') %}
                {%- set content = content.split('</think>')[-1].lstrip('\n') %}
            {%- endif %}
            {{- '<｜Assistant｜><think>\n' + reasoning_content.strip('\n') + '\n</think>\n\n' + content }}
            {{- '<｜end▁of▁sentence｜>' }}
        {%- endif %}
        {%- endgeneration %}
    {%- elif message.role == 'tool' %}
        {%- set ns.is_tool = true %}
        {%- if ns.is_output_first %}
            {%- set ns.is_output_first = false %}
            {{- '<｜tool▁outputs▁begin｜><｜tool▁output▁begin｜>' + message.content + '<｜tool▁output▁end｜>' }}
        {%- else %}
            {{- '\n<｜tool▁output▁begin｜>' + message.content + '<｜tool▁output▁end｜>' }}
        {%- endif %}
    {%- endif %}
{%- endfor %}
{%- if ns.is_tool %}
    {{- '<｜tool▁outputs▁end｜>' }}
{%- endif %}
{%- if add_generation_prompt and not ns.is_tool %}
    {{- '<｜Assistant｜><think>\n' }}
{%- endif %}
